<Window x:Class="Inventory.App.Views.BalanceExportDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Language="vi-VN"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Title="Xuất sổ cân đối - Chọn mặt hàng"
        Height="620"
        Width="990"
        MinWidth="750"
        MinHeight="400"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="CenterAlignedCell" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RightAlignedCell" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tiêu đề và tổng quan -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="HeaderText"
                       Text="Sổ cân đối"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="#1E293B"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="SummaryText"
                       Text="Đã chọn: 0/0"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="#475569"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>
        </DockPanel>

        <!-- Thanh công cụ lọc và chọn nhanh -->
        <Border Grid.Row="1" Background="#F1F5F9" CornerRadius="4" Padding="10,8" Margin="0,0,0,10">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="OmitZeroStockCheckBox"
                              Content="Bỏ mặt hàng tồn ngày lập phiếu bằng 0"
                              FontWeight="SemiBold"
                              VerticalAlignment="Center"
                              Margin="0,0,16,0"
                              Checked="OmitZeroStock_OnChanged"
                              Unchecked="OmitZeroStock_OnChanged"
                              ToolTip="Tự động bỏ tick các mặt hàng có tồn ngày lập phiếu bằng 0."/>
                    <Button Content="Chọn tất cả" Padding="10,4" Margin="0,0,8,0" Click="SelectAll_OnClick" Style="{StaticResource PrimaryButtonStyle}"/>
                    <Button Content="Bỏ chọn tất cả" Padding="10,4" Margin="0,0,16,0" Click="DeselectAll_OnClick" Style="{StaticResource SecondaryButtonStyle}"/>
                </StackPanel>
                <DockPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Tìm kiếm:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#475569"/>
                    <TextBox x:Name="SearchBox" Width="200" Height="26" VerticalContentAlignment="Center"
                             TextChanged="SearchBox_OnTextChanged"
                             ToolTip="Tìm theo mã hàng hoặc tên mặt hàng"/>
                </DockPanel>
            </DockPanel>
        </Border>

        <!-- Bảng danh sách mặt hàng có tick -->
        <DataGrid Grid.Row="2"
                  x:Name="ItemsGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="46" IsReadOnly="False">
                    <DataGridTemplateColumn.Header>
                        <CheckBox x:Name="HeaderSelectAllCheckBox"
                                  ToolTip="Chọn hoặc bỏ chọn tất cả mặt hàng đang hiển thị"
                                  HorizontalAlignment="Center"
                                  Checked="HeaderSelectAll_OnChecked"
                                  Unchecked="HeaderSelectAll_OnUnchecked"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="STT" Binding="{Binding RowNumber}" Width="45" IsReadOnly="True" ElementStyle="{StaticResource CenterAlignedCell}"/>
                <DataGridTextColumn Header="Mã hàng" Binding="{Binding ItemCode}" Width="120" IsReadOnly="True"/>
                <DataGridTextColumn Header="Tên mặt hàng" Binding="{Binding ItemName}" Width="*" MinWidth="160" IsReadOnly="True"/>
                <DataGridTextColumn Header="ĐVT" Binding="{Binding Unit}" Width="60" IsReadOnly="True" ElementStyle="{StaticResource CenterAlignedCell}"/>
                <DataGridTextColumn Header="Tồn ngày lập phiếu" Binding="{Binding TotalAtIssueDate, StringFormat=N0}" Width="135" IsReadOnly="True" ElementStyle="{StaticResource CenterAlignedCell}"/>
                <DataGridTextColumn Header="Số lượng xuất" Binding="{Binding Quantity, StringFormat=N0}" Width="100" IsReadOnly="True" ElementStyle="{StaticResource CenterAlignedCell}"/>
                <DataGridTextColumn Header="Còn lại" Binding="{Binding RemainingAtIssueDate, StringFormat=N0}" Width="95" IsReadOnly="True" ElementStyle="{StaticResource CenterAlignedCell}"/>
                <DataGridTextColumn Header="Đơn giá" Binding="{Binding UnitPrice, StringFormat=N0}" Width="100" IsReadOnly="True" ElementStyle="{StaticResource RightAlignedCell}"/>
                <DataGridTextColumn Header="Thành tiền" Binding="{Binding Amount, StringFormat=N0}" Width="110" IsReadOnly="True" ElementStyle="{StaticResource RightAlignedCell}"/>
                <DataGridTextColumn Header="Ghi chú" Binding="{Binding Note}" Width="120" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Nút hành động ở chân bảng -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="* Các mặt hàng được tick chọn sẽ được xuất vào sổ cân đối."
                       FontStyle="Italic"
                       Foreground="#64748B"
                       VerticalAlignment="Center"
                       DockPanel.Dock="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                <Button Content="Xuất Word" Padding="14,6" Margin="0,0,8,0" Click="ExportWord_OnClick" Style="{StaticResource ExportButtonStyle}" ToolTip="Xuất sổ cân đối định dạng Word (.docx)"/>
                <Button Content="Xuất Excel" Padding="14,6" Margin="0,0,12,0" Click="ExportExcel_OnClick" Style="{StaticResource ExportButtonStyle}" ToolTip="Xuất sổ cân đối định dạng Excel (.xlsx)"/>
                <Button Content="Đóng" Width="80" Padding="0,6" IsCancel="True" Click="Close_OnClick" Style="{StaticResource SecondaryButtonStyle}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
