<Window x:Class="Inventory.App.Views.BalanceIssueDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:Inventory.App.Helpers"
        xmlns:views="clr-namespace:Inventory.App.Views"
        Language="vi-VN"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Title="Chi tiết phiếu cân đối"
        Height="720"
        Width="1200">
    <Window.Resources>
        <Style x:Key="CenterAlignedCell" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RightAlignedCell" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="LeftAlignedEditCell" TargetType="TextBox">
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding TitleText}" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
            <UniformGrid Columns="3">
                <StackPanel Margin="0,0,12,4">
                    <TextBlock Text="Tên phiếu cân đối" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Balance.IssueNumber}"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,4">
                    <TextBlock Text="Thời gian" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Balance.IssueDate, StringFormat=dd/MM/yyyy}"/>
                </StackPanel>
                <StackPanel Margin="0,0,12,4">
                    <TextBlock Text="Tổng tiền" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Balance.TotalAmount, StringFormat=N0}"/>
                </StackPanel>
            </UniformGrid>
        </StackPanel>

        <TabControl Grid.Row="1">
            <TabItem Header="Phiếu xuất theo đơn vị">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Chọn tất cả" Padding="10,4" Margin="0,0,8,0" Click="SelectAllUnits_OnClick" Style="{StaticResource PrimaryButtonStyle}"/>
                        <Button Content="Bỏ chọn" Padding="10,4" Margin="0,0,8,0" Click="ClearUnitSelection_OnClick" Style="{StaticResource SecondaryButtonStyle}"/>
                        <TextBlock Text="{Binding SelectedUnitCountText}"
                                   VerticalAlignment="Center"
                                   Foreground="Gray"/>
                    </StackPanel>

                    <Border Grid.Row="1" Padding="10,6" Margin="0,0,0,8"
                            Background="#FFFFF7ED" BorderBrush="#FFF97316" BorderThickness="1" CornerRadius="4"
                            Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Có thay đổi chưa lưu — hãy bấm Lưu thay đổi để ghi nhận."
                                   Foreground="#FF9A3412" FontWeight="SemiBold"/>
                    </Border>

                    <DataGrid Grid.Row="2"
                              x:Name="UnitIssuesGrid"
                              ItemsSource="{Binding UnitIssueRows}"
                              SelectedItem="{Binding SelectedUnitIssue}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              SelectionUnit="CellOrRowHeader"
                              SelectionMode="Single"
                              helpers:ExcelLikeDataGridNavigation.IsEnabled="True"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              PreviewMouseDoubleClick="UnitIssuesGrid_OnPreviewMouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Chọn" Width="55" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Xem" Width="54" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="👁" Width="32" Height="24" Padding="0"
                                                ToolTip="Xem trước nội dung phiếu"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="PreviewUnitIssueRow_OnClick"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="STT" Binding="{Binding RowNumber}" Width="50" IsReadOnly="True"
                                                ElementStyle="{StaticResource CenterAlignedCell}"/>
                            <DataGridTextColumn Header="Số phiếu"
                                                Binding="{Binding IssueNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Width="150" MinWidth="110"
                                                IsReadOnly="False"
                                                EditingElementStyle="{StaticResource LeftAlignedEditCell}"/>
                            <DataGridTextColumn Header="Đơn vị trực thuộc" Binding="{Binding UnitName}" Width="140" MinWidth="120" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Người nhận"
                                                Binding="{Binding ReceivedBy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Width="120" MinWidth="80"
                                                IsReadOnly="False"
                                                EditingElementStyle="{StaticResource LeftAlignedEditCell}"/>
                            <DataGridTemplateColumn Header="Ngày" Width="120" IsReadOnly="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding IssueDate, StringFormat=dd/MM/yyyy}"
                                                   VerticalAlignment="Center" Margin="4,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <DatePicker SelectedDate="{Binding IssueDate, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                                    VerticalAlignment="Stretch"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalContentAlignment="Center"
                                                    BorderThickness="0"
                                                    Background="Transparent"
                                                    Padding="4,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Lý do xuất"
                                                Binding="{Binding Reason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Width="160" MinWidth="100"
                                                IsReadOnly="False"
                                                EditingElementStyle="{StaticResource LeftAlignedEditCell}"/>
                            <DataGridTextColumn Header="Số dòng" Binding="{Binding LineCount}" Width="70" IsReadOnly="True"
                                                ElementStyle="{StaticResource CenterAlignedCell}"/>
                            <DataGridTextColumn Header="Tổng SL" Binding="{Binding TotalQuantity, StringFormat=N0}" Width="80" IsReadOnly="True"
                                                ElementStyle="{StaticResource CenterAlignedCell}"/>
                            <DataGridTextColumn Header="Thành tiền" Binding="{Binding TotalAmount, StringFormat=N0}" Width="110" IsReadOnly="True"
                                                ElementStyle="{StaticResource RightAlignedCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="Nháy đúp ô có thể sửa để nhập. Chọn dòng rồi bấm Xem trước để xem phiếu."
                                   VerticalAlignment="Center"
                                   Foreground="Gray"
                                   Margin="0,0,16,0"/>
                        <Button Content="Lưu thay đổi" Padding="10,4" Margin="0,0,8,0" Click="SaveUnitHeaders_OnClick"
                                IsEnabled="{Binding HasDirtyRows}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                ToolTip="Lưu số phiếu, ngày, người nhận/giao, lý do của từng phiếu xuất con (không đổi tồn)."/>
                        <Button Content="Xem trước" Padding="10,4" Margin="0,0,8,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="ViewUnitIssue_OnClick"
                                ToolTip="Xem nhanh nội dung phiếu xuất, không tạo file Word."/>
                        <Button Content="Xuất phiếu xuất đã chọn" Padding="10,4" Margin="0,0,8,0"
                                Style="{StaticResource ExportButtonStyle}"
                                Click="ExportSelectedUnitIssues_OnClick"
                                ToolTip="Chọn xuất gộp một file hoặc tách từng file."/>
                        <Button Content="Xuất sổ cân đối" Padding="10,4" Click="ExportOverview_OnClick" Style="{StaticResource ExportButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Cân đối">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="{Binding StockSnapshotCaption}"
                               FontWeight="SemiBold"
                               Foreground="#555555"
                               Margin="0,0,0,8"/>
                    <Grid Grid.Row="1" x:Name="OverviewSplitHost">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" MinWidth="260"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="1.1*" MinWidth="260"/>
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0">
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource SplitPaneCaption}" Text="Thông tin chính"/>
                            <DataGrid x:Name="OverviewGrid"
                                      Style="{StaticResource AlignedSplitDataGrid}"
                                      VerticalScrollBarVisibility="Hidden"
                                      ItemsSource="{Binding OverviewRows}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      SelectionChanged="OverviewGrid_OnSelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="STT"
                                                        Binding="{Binding RowNumber, Mode=OneWay}"
                                                        Width="50"
                                                        ElementStyle="{StaticResource CenterAlignedCell}"/>
                                    <DataGridTextColumn Header="Mã hàng" Binding="{Binding ItemCode, Mode=OneWay}" Width="140" MinWidth="100"/>
                                    <DataGridTextColumn Header="Tên mặt hàng" Binding="{Binding ItemName, Mode=OneWay}" Width="220" MinWidth="140"/>
                                    <DataGridTextColumn x:Name="OverviewQuantityColumn"
                                                        Header="Tồn ngày lập phiếu"
                                                        Binding="{Binding TotalAtIssueDate, Mode=OneWay, StringFormat=N0}"
                                                        Width="125"
                                                        ElementStyle="{StaticResource CenterAlignedCell}"/>
                                    <DataGridTextColumn Header="Số lượng xuất"
                                                        Binding="{Binding Quantity, Mode=OneWay, StringFormat=N0}"
                                                        Width="105"
                                                        ElementStyle="{StaticResource CenterAlignedCell}"/>
                                    <DataGridTextColumn Header="Còn lại"
                                                        Binding="{Binding RemainingAtIssueDate, Mode=OneWay, StringFormat=N0}"
                                                        Width="100"
                                                        ElementStyle="{StaticResource CenterAlignedCell}"/>
                                    <DataGridTextColumn Header="Đơn giá"
                                                        Binding="{Binding UnitPrice, Mode=OneWay, StringFormat=N0}"
                                                        Width="100"
                                                        ElementStyle="{StaticResource RightAlignedCell}"/>
                                    <DataGridTextColumn Header="Thành tiền"
                                                        Binding="{Binding Amount, Mode=OneWay, StringFormat=N0}"
                                                        Width="110"
                                                        ElementStyle="{StaticResource RightAlignedCell}"/>
                                    <DataGridTextColumn Header="Ghi chú" Binding="{Binding Note, Mode=OneWay}" Width="140" MinWidth="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>

                        <GridSplitter x:Name="OverviewSplitter" Grid.Column="1"
                                      Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                      Background="#DDDDDD" ResizeBehavior="PreviousAndNext"/>

                        <DockPanel Grid.Column="2" x:Name="OverviewUnitsPanel">
                            <DockPanel DockPanel.Dock="Top">
                                <Button x:Name="ToggleOverviewUnitHeaderModeButton"
                                        DockPanel.Dock="Right"
                                        Content="Hiện tên đơn vị"
                                        Padding="10,4"
                                        Margin="8,0,0,0"
                                        Click="ToggleOverviewUnitHeaderMode_OnClick"
                                        Style="{StaticResource WarningButtonStyle}"
                                        ToolTip="Đổi tiêu đề cột giữa tên và mã đơn vị; lựa chọn được lưu cho lần sau."/>
                                <TextBlock Style="{StaticResource SplitPaneCaption}" Text="Đơn vị trực thuộc"/>
                            </DockPanel>
                            <DataGrid x:Name="OverviewUnitsGrid"
                                      Style="{StaticResource AlignedSplitDataGrid}"
                                      ItemsSource="{Binding OverviewRows}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      SelectionChanged="OverviewUnitsGrid_OnSelectionChanged"/>
                        </DockPanel>
                    </Grid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Xuất sổ cân đối" Padding="10,4" Click="ExportOverview_OnClick"
                                Style="{StaticResource ExportButtonStyle}"
                                ToolTip="Xuất sổ cân đối theo template Word phiếu cân đối."/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Đóng" Width="90" IsCancel="True" Click="Close_OnClick" Style="{StaticResource SecondaryButtonStyle}"/>
        </StackPanel>
        <views:BusyOverlay x:Name="BusyOverlay"
                           Grid.RowSpan="3"
                           Visibility="Collapsed"/>
    </Grid>
</Window>
