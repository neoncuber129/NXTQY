<UserControl x:Class="Inventory.App.Views.BusyOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <Border Background="#660F172A"
            Cursor="Wait"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
        <Border Width="330"
                Padding="22"
                Background="White"
                BorderBrush="#FF93C5FD"
                BorderThickness="1"
                CornerRadius="6"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Đang xử lý"
                           FontWeight="SemiBold"
                           FontSize="16"
                           HorizontalAlignment="Center"/>
                <ProgressBar IsIndeterminate="True"
                             Height="8"
                             Margin="0,14,0,10"/>
                <TextBlock Text="{Binding Message, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="#FF475569"/>
            </StackPanel>
        </Border>
    </Border>
</UserControl>
