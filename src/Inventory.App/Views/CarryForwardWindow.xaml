<Window x:Class="Inventory.App.Views.CarryForwardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Language="vi-VN"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Title="Chuyển kỳ tồn kho"
        Height="620"
        Width="640">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Chuyển kỳ tồn kho" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="{Binding OperationSubtitle}" Margin="0,4,0,0" Foreground="#555" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" Padding="12" Margin="0,0,0,12" Background="#FAFAFA">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Năm nguồn (đã kết thúc)" FontWeight="SemiBold" Foreground="#666"/>
                    <TextBlock Text="{Binding FromYear}" FontSize="28" FontWeight="Bold" Margin="0,4,0,0"/>
                    <TextBlock Text="Tồn cuối năm →" Margin="0,8,0,0" Foreground="#666"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="→" FontSize="28" VerticalAlignment="Center" Margin="16,0" FontWeight="Bold"/>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Năm đích (đang chọn)" FontWeight="SemiBold" Foreground="#666"/>
                    <TextBlock Text="{Binding ToYear}" FontSize="28" FontWeight="Bold" Margin="0,4,0,0"/>
                    <TextBlock Text="→ Tồn đầu năm" Margin="0,8,0,0" Foreground="#666"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Thông tin thao tác" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Tên thao tác" Margin="0,0,0,6" Foreground="#555"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding OperationName}" FontWeight="SemiBold" Margin="0,0,0,6"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Thời điểm mở form" Margin="0,0,0,6" Foreground="#555"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OpenedAtText}" Margin="0,0,0,6"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Năm làm việc hiện tại" Margin="0,0,0,6" Foreground="#555"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding WorkingYearText}" Margin="0,0,0,6"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Nội dung chuyển" Margin="0,0,0,6" Foreground="#555"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TransferDescription}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                </Grid>

                <TextBlock Text="Tóm tắt dữ liệu" FontWeight="SemiBold" Margin="0,4,0,8"/>
                <UniformGrid Columns="2" Margin="0,0,0,12">
                    <Border BorderBrush="#E0E0E0" BorderThickness="1" Padding="10" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="{Binding FromYearHeader}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding FromSummaryText}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border BorderBrush="#E0E0E0" BorderThickness="1" Padding="10" Margin="6,0,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding ToYearHeader}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ToSummaryText}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Margin="0,0,0,12"
                           Foreground="{Binding StatusBrush}"/>

                <CheckBox Content="{Binding AllowUpdateOpeningText}"
                          IsChecked="{Binding AllowUpdateOpeningWithExistingActivity}"
                          Visibility="{Binding HasTargetActivity, Converter={StaticResource BooleanToVisibilityConverter}}"
                          FontWeight="SemiBold"
                          Foreground="#C0392B"
                          ToolTip="Cho phép cập nhật lại số tồn đầu năm đích theo tồn cuối năm nguồn, giữ nguyên các phiếu nhập/xuất đã lập và tự động tính lại sổ cái chi tiết."
                          Margin="0,0,0,8"/>

                <CheckBox Content="Không chuyển mặt hàng tồn cuối bằng 0 sang Dashboard năm sau (mặc định)"
                          IsChecked="{Binding ExcludeZeroClosingStock}"
                          IsEnabled="{Binding CanExecute}"
                          ToolTip="Các mặt hàng có số lượng tồn cuối năm trước bằng 0 sẽ không còn xuất hiện trên Dashboard của năm sau. Nếu năm sau có nhập kho mới, mặt hàng sẽ tự động xuất hiện lại."
                          Margin="0,0,0,8"/>

                <CheckBox Content="Backup trước khi chuyển kỳ (khuyến nghị)"
                          IsChecked="{Binding CreateBackup}"
                          IsEnabled="{Binding CanExecute}"
                          Margin="0,0,0,8"/>
                <Grid IsEnabled="{Binding CreateBackup}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Tên / đường dẫn file backup" Foreground="#555" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding BackupFilePath, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding CanExecute}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Chọn…" Width="72" Height="28" VerticalAlignment="Bottom"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="BrowseBackup_OnClick" IsEnabled="{Binding CanExecute}"/>
                </Grid>
                <TextBlock Text="{Binding BackupHint}" Margin="0,6,0,0" Foreground="#777" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="3" Text="Phiếu nhập/xuất không bị copy — chỉ chuyển số tồn cuối năm nguồn thành tồn đầu năm đích."
                   Foreground="#777" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,12"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Thực hiện chuyển kỳ" Width="150" Height="32" Margin="0,0,8,0"
                    Style="{StaticResource WarningButtonStyle}"
                    IsEnabled="{Binding CanExecute}" Click="Confirm_OnClick"/>
            <Button Content="Hủy" Width="90" Height="32" IsCancel="True" Click="Cancel_OnClick" Style="{StaticResource SecondaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
