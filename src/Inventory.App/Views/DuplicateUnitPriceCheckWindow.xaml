<Window x:Class="Inventory.App.Views.DuplicateUnitPriceCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Language="vi-VN"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Title="Cảnh báo trùng đơn giá mặt hàng"
        Width="700"
        Height="500"
        MinWidth="580"
        MinHeight="380"
        Loaded="Window_OnLoaded">
    <DockPanel Margin="20" LastChildFill="True">
        <!-- Nút hành động ở dưới -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="ContinueButton" Content="Vẫn lưu phiếu" Width="130" Margin="0,0,10,0"
                    IsDefault="True" Click="Continue_OnClick" Style="{StaticResource PrimaryButtonStyle}"/>
            <Button Content="Quay lại kiểm tra" Width="140" IsCancel="True" Click="Cancel_OnClick" Style="{StaticResource SecondaryButtonStyle}"/>
        </StackPanel>

        <!-- Header thông báo -->
        <Border DockPanel.Dock="Top" Background="#FFFEF2F2" BorderBrush="#FFFCA5A5" BorderThickness="1"
                CornerRadius="6" Padding="14" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Phát hiện trùng đơn giá giữa các mặt hàng"
                           FontWeight="Bold" FontSize="15" Foreground="#FF991B1B"/>
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#FF7F1D1D" LineHeight="18"
                           Text="Hệ thống phát hiện có đơn giá trùng nhau trong phiếu hoặc trùng với mặt hàng trên Dashboard. Vui lòng kiểm tra lại để tránh gõ nhầm tên hoặc sai đơn giá."/>
            </StackPanel>
        </Border>

        <!-- Nội dung danh sách trùng theo nhóm đơn giá -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="GroupsContainer"/>
        </ScrollViewer>
    </DockPanel>
</Window>
