<Window x:Class="Inventory.App.Views.IssueDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:Inventory.App.Helpers"
        xmlns:views="clr-namespace:Inventory.App.Views"
        Language="vi-VN"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Height="720"
        Width="1400"
        MinWidth="900"
        Title="{Binding DialogTitle}">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding AddLineCommand}"/>
        <KeyBinding Key="Insert" Modifiers="Control" Command="{Binding AddLineCommand}"/>
    </Window.InputBindings>
    <Window.Resources>
        <Style x:Key="RightAlignedCell" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="CenterAlignedCell" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="WrappedCell" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="LeftAlignedEditCell" TargetType="TextBox">
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>
        <Style x:Key="RightAlignedEditCell" TargetType="TextBox">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="2,0,8,0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding DialogTitle}" FontWeight="Bold" FontSize="18" Margin="0,0,0,8"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <StackPanel Margin="0,0,16,0" MinWidth="220">
                <TextBlock Text="Tên / số phiếu cân đối"/>
                <TextBox Text="{Binding IssueNumber, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel MinWidth="160" Margin="0,0,16,0">
                <TextBlock Text="Thời gian"/>
                <DatePicker SelectedDate="{Binding IssueDate}"/>
            </StackPanel>
            <StackPanel MinWidth="360">
                <TextBlock Text="Lý do xuất"/>
                <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="2" Padding="10,6" Margin="0,0,0,8"
                Background="#FFFFF7ED" BorderBrush="#FFF97316" BorderThickness="1" CornerRadius="4"
                Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="Có thay đổi chưa lưu — hãy bấm Lưu để ghi nhận."
                       Foreground="#FF9A3412" FontWeight="SemiBold"/>
        </Border>

        <Grid Grid.Row="3" x:Name="LinesSplitHost" SizeChanged="LinesSplitHost_OnSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LinesColumnDefinition" Width="700" MinWidth="420"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition x:Name="UnitsColumnDefinition" Width="*" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SplitPaneCaption}" Text="Thông tin chính"/>
                <DataGrid x:Name="LinesGrid"
                          Style="{StaticResource AlignedSplitDataGrid}"
                          VerticalScrollBarVisibility="Hidden"
                          ItemsSource="{Binding Lines}"
                          SelectedItem="{Binding SelectedLine}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          helpers:ExcelLikeDataGridNavigation.IsEnabled="True"
                          SelectionChanged="LinesGrid_OnSelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="55" IsReadOnly="True">
                            <DataGridTemplateColumn.Header>
                                <CheckBox ToolTip="Chọn hoặc bỏ chọn tất cả"
                                          HorizontalAlignment="Center"
                                          Checked="SelectAllLines_OnChanged"
                                          Unchecked="SelectAllLines_OnChanged"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="STT"
                                            Binding="{Binding RowNumber}"
                                            IsReadOnly="True"
                                            ElementStyle="{StaticResource CenterAlignedCell}"
                                            Width="50"/>
                        <DataGridTemplateColumn x:Name="ItemCodeColumn" Header="Mặt hàng" Width="180" MinWidth="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ItemCode}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding ItemCode}"
                                               VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <views:ItemSuggestBox
                                        VerticalAlignment="Stretch"
                                        HorizontalAlignment="Stretch"
                                        Text="{Binding ItemCode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                        ItemsSource="{Binding DataContext.Items, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Tồn ngày lập phiếu"
                                            IsReadOnly="True"
                                            Binding="{Binding StockAtIssueDateQuantity, StringFormat=N0}"
                                            ElementStyle="{StaticResource CenterAlignedCell}"
                                            Width="120"/>
                        <DataGridTextColumn Header="Số lượng xuất"
                                            x:Name="QuantityColumn"
                                            IsReadOnly="True"
                                            Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, StringFormat=N0, TargetNullValue=''}"
                                            ElementStyle="{StaticResource CenterAlignedCell}"
                                            Width="105"/>
                        <DataGridTextColumn Header="Còn lại"
                                            IsReadOnly="True"
                                            Binding="{Binding AvailableQuantity, StringFormat=N0}"
                                            ElementStyle="{StaticResource CenterAlignedCell}"
                                            Width="90"/>
                        <DataGridTextColumn Header="Đơn giá"
                                            Binding="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged, StringFormat=N0}"
                                            ElementStyle="{StaticResource RightAlignedCell}"
                                            EditingElementStyle="{StaticResource RightAlignedEditCell}"
                                            Width="100"/>
                        <DataGridTextColumn Header="Thành tiền"
                                            IsReadOnly="True"
                                            Binding="{Binding Amount, StringFormat=N0}"
                                            ElementStyle="{StaticResource RightAlignedCell}"
                                            Width="110"/>
                        <DataGridTextColumn Header="Ghi chú"
                                            Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                                            Width="140"
                                            MinWidth="100"
                                            EditingElementStyle="{StaticResource LeftAlignedEditCell}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <GridSplitter Grid.Column="1" x:Name="LinesSplitter"
                          Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="#DDDDDD" ResizeBehavior="PreviousAndNext"/>

            <DockPanel Grid.Column="2" x:Name="UnitsPanel">
                <DockPanel DockPanel.Dock="Top">
                    <Button x:Name="ToggleUnitHeaderModeButton"
                            DockPanel.Dock="Right"
                            Content="Hiện tên đơn vị"
                            Click="ToggleUnitHeaderMode_OnClick"
                            Margin="8,0,0,0"
                            Style="{StaticResource WarningButtonStyle}"
                            ToolTip="Đổi tiêu đề cột giữa tên và mã đơn vị; lựa chọn được lưu cho lần sau."/>
                    <TextBlock Style="{StaticResource SplitPaneCaption}" Text="Đơn vị trực thuộc"/>
                </DockPanel>
                <DataGrid x:Name="UnitsGrid"
                          Style="{StaticResource AlignedSplitDataGrid}"
                          ItemsSource="{Binding Lines}"
                          SelectedItem="{Binding SelectedLine}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          helpers:ExcelLikeDataGridNavigation.IsEnabled="True"
                          SelectionChanged="UnitsGrid_OnSelectionChanged"/>
            </DockPanel>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,8">
            <TextBlock Text="Trái: thông tin chính. Phải: phân bổ đơn vị. Có thể giữ dòng SL = 0 trên phiếu cân đối (không sinh phiếu xuất đơn vị). Dòng đỏ = vượt tồn."
                       VerticalAlignment="Center"
                       Foreground="Gray"
                       Margin="0,0,16,0"
                       TextWrapping="Wrap"
                       MaxWidth="720"/>
            <Button Content="Chọn mặt hàng…" Click="OpenItemPicker_Click" Margin="0,0,8,0" Padding="10,4" Style="{StaticResource PrimaryButtonStyle}"/>
            <Button Content="Thêm dòng" Command="{Binding AddLineCommand}" Margin="0,0,8,0"
                    Style="{StaticResource SuccessButtonStyle}"
                    ToolTip="Thêm dòng mới (Ctrl+N hoặc Ctrl+Insert)"/>
            <Button Content="Xóa dòng đã chọn" Command="{Binding RemoveSelectedLinesCommand}" Style="{StaticResource DangerButtonStyle}"/>
            <Button x:Name="ExcelWorkspaceButton"
                    Content="Nhập bằng Excel"
                    Click="ExcelWorkspace_Click"
                    Margin="8,0,0,0"
                    Style="{StaticResource ExportButtonStyle}"
                    ToolTip="Mở file Excel tạm (đã khóa): chỉ nhập số lượng theo từng đơn vị. Không thêm / sửa mặt hàng. Ctrl+S để đồng bộ về form."/>
            <TextBlock x:Name="ExcelSyncStatusText"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0"
                       Foreground="#FF1D4ED8"
                       Visibility="Collapsed"/>
        </StackPanel>

        <DockPanel Grid.Row="5">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock FontWeight="Bold" Text="{Binding TotalAmount, StringFormat=Tổng tiền: {0:N0}}"/>
                <TextBlock Text="{Binding UpperLevelAmount, StringFormat=Trên cấp: {0:N0}}"/>
                <TextBlock Text="{Binding SelfProcuredAmount, StringFormat=Tự mua sắm: {0:N0}}"/>
                <TextBlock Text="{Binding TotalAmountText, StringFormat=Bằng chữ: {0}}" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Lưu" Width="90" Margin="0,0,8,0" Click="Save_Click"
                        PreviewMouseLeftButtonDown="Save_OnPreviewMouseLeftButtonDown"
                        Style="{StaticResource PrimaryButtonStyle}"/>
                <Button Content="Hủy" Width="90" Click="Cancel_Click" Style="{StaticResource SecondaryButtonStyle}"/>
            </StackPanel>
        </DockPanel>
        <views:BusyOverlay x:Name="BusyOverlay"
                           Grid.RowSpan="6"
                           Visibility="Collapsed"/>
    </Grid>
</Window>
