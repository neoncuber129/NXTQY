<Window x:Class="Inventory.App.Views.ItemVariantChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Language="vi-VN"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Title="Chọn thuộc tính mặt hàng"
        Width="680"
        MinWidth="560"
        MinHeight="420"
        MaxHeight="900"
        SizeToContent="Height"
        Loaded="Window_OnLoaded">
    <DockPanel Margin="20" LastChildFill="True">
        <!-- Nút luôn neo dưới, không bị cắt khi DPI / nội dung dài -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="ConfirmButton" Content="Xác nhận" Width="110" Margin="0,0,8,0"
                    IsDefault="True"
                    Click="Confirm_OnClick" Style="{StaticResource PrimaryButtonStyle}"/>
            <Button Content="Hủy" Width="90" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}"/>
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" x:Name="HintText" Margin="0,12,0,0"
                   Foreground="#FF64748B" TextWrapping="Wrap"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      MaxHeight="560">
            <StackPanel>
                <Border Background="#FFEFF6FF" BorderBrush="#FFBFDBFE" BorderThickness="1"
                        CornerRadius="6" Padding="14" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Cùng tên và đơn giá với mặt hàng đã có"
                                   FontWeight="SemiBold" FontSize="15" Foreground="#FF1E3A8A"/>
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#FF1E40AF" LineHeight="20"
                                   Text="Nên chọn danh mục đã có (cùng tên + giá thường dùng chung danh mục). Chỉ chọn danh mục mới trên phiếu khi thật sự là biến thể khác. Loại hàng: chọn «trên cấp» hoặc «tự mua sắm»."/>
                    </StackPanel>
                </Border>

                <Border Background="#FFF8FAFC" BorderBrush="#FFE2E8F0" BorderThickness="1"
                        CornerRadius="6" Padding="14" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Tên mặt hàng" Foreground="#FF64748B" FontSize="12"/>
                            <TextBlock x:Name="ItemNameText" Margin="0,4,0,0" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Đơn giá" Foreground="#FF64748B" FontSize="12"/>
                            <TextBlock x:Name="UnitPriceText" Margin="0,4,0,0" FontWeight="SemiBold" FontSize="15"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Danh mục — ưu tiên chọn mục «đã có»" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Margin="0,0,0,8" FontSize="12" Foreground="#FF64748B" TextWrapping="Wrap"
                               Text="Chọn danh mục sẵn có để gắn mã cũ. Mục «mới trên phiếu» chỉ khi cần tạo biến thể riêng."/>
                    <WrapPanel x:Name="CategoryChoicesPanel"/>
                </StackPanel>

                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Loại hàng — bấm để chọn" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <WrapPanel x:Name="UsageChoicesPanel"/>
                </StackPanel>

                <Border Background="#FFF0FDF4" BorderBrush="#FFBBF7D0" BorderThickness="1"
                        CornerRadius="6" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Kết quả lựa chọn" FontWeight="SemiBold" Foreground="#FF166534"/>
                        <TextBlock x:Name="ResultPreviewText" Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="20"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
