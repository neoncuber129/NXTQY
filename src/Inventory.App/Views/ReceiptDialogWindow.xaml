<Window x:Class="Inventory.App.Views.ReceiptDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:Inventory.App.Helpers"
        xmlns:views="clr-namespace:Inventory.App.Views"
        Language="vi-VN"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Height="700"
        Width="1100"
        Title="{Binding DialogTitle}">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding AddLineCommand}"/>
        <KeyBinding Key="Insert" Modifiers="Control" Command="{Binding AddLineCommand}"/>
    </Window.InputBindings>
    <Window.Resources>
        <Style x:Key="RightAlignedCell" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="CenterAlignedCell" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="LeftAlignedEditCell" TargetType="TextBox">
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>
        <Style x:Key="RightAlignedEditCell" TargetType="TextBox">
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="2,0,8,0"/>
        </Style>
        <Style x:Key="CenterAlignedEditCell" TargetType="TextBox">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="2,0"/>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding DialogTitle}" FontWeight="Bold" FontSize="18" Margin="0,0,0,8"/>

        <UniformGrid Grid.Row="1" Columns="6" Margin="0,0,0,8">
            <StackPanel Margin="3">
                <TextBlock Text="Số phiếu"/>
                <TextBox Text="{Binding ReceiptNumber, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="3">
                <TextBlock Text="Ngày"/>
                <DatePicker SelectedDate="{Binding ReceiptDate}"/>
            </StackPanel>
            <StackPanel Margin="3">
                <TextBlock Text="Theo Kế hoạch"/>
                <TextBox Text="{Binding DeliveredBy, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="3">
                <TextBlock Text="Theo Hoá đơn số"/>
                <TextBox Text="{Binding DeliveredUnit, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="3">
                <TextBlock Text="Người nhận"/>
                <TextBox Text="{Binding ReceivedBy, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Margin="3">
                <TextBlock Text="Lý do nhập"/>
                <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
        </UniformGrid>

        <Border Grid.Row="2" Padding="10,6" Margin="0,0,0,8"
                Background="#FFFFF7ED" BorderBrush="#FFF97316" BorderThickness="1" CornerRadius="4"
                Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="Có thay đổi chưa lưu — hãy bấm Lưu để ghi nhận."
                       Foreground="#FF9A3412" FontWeight="SemiBold"/>
        </Border>

        <DataGrid x:Name="LinesGrid"
                  Grid.Row="3"
                  ItemsSource="{Binding Lines}"
                  SelectedItem="{Binding SelectedLine}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  helpers:ExcelLikeDataGridNavigation.IsEnabled="True"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="55" IsReadOnly="True">
                    <DataGridTemplateColumn.Header>
                        <CheckBox ToolTip="Chọn hoặc bỏ chọn tất cả"
                                  HorizontalAlignment="Center"
                                  Checked="SelectAllLines_OnChanged"
                                  Unchecked="SelectAllLines_OnChanged"/>
                    </DataGridTemplateColumn.Header>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="STT"
                                    Binding="{Binding RowNumber}"
                                    IsReadOnly="True"
                                    Width="50"
                                    ElementStyle="{StaticResource CenterAlignedCell}"/>
                <DataGridTemplateColumn Header="Mã / mặt hàng" Width="200" MinWidth="140">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ItemCode}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <views:ItemSuggestBox
                                VerticalAlignment="Stretch"
                                HorizontalAlignment="Stretch"
                                Text="{Binding ItemCode, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                ItemsSource="{Binding DataContext.Items, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Danh mục" Width="120" MinWidth="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Category}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Category, UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource LeftAlignedEditCell}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Tên mặt hàng" Width="180" MinWidth="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ItemName}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding ItemName, UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource LeftAlignedEditCell}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="ĐVT" Width="70">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Unit}"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding Unit, UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource CenterAlignedEditCell}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Loại sử dụng" Width="110" MinWidth="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding UsageType}"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Stretch"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding UsageType, UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource CenterAlignedEditCell}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Đơn giá"
                                    Binding="{Binding UnitPrice, UpdateSourceTrigger=LostFocus, StringFormat={}{0:#\,##0.##}}"
                                    Width="110"
                                    ElementStyle="{StaticResource RightAlignedCell}"
                                    EditingElementStyle="{StaticResource RightAlignedEditCell}"/>
                <DataGridTextColumn Header="Số lượng"
                                    Binding="{Binding Quantity, UpdateSourceTrigger=LostFocus, StringFormat=N0}"
                                    Width="100"
                                    ElementStyle="{StaticResource CenterAlignedCell}"
                                    EditingElementStyle="{StaticResource CenterAlignedEditCell}"/>
                <DataGridTextColumn Header="Thành tiền"
                                    Binding="{Binding Amount, Mode=OneWay, StringFormat=N0}"
                                    Width="110"
                                    IsReadOnly="True"
                                    ElementStyle="{StaticResource RightAlignedCell}"/>
                <DataGridTextColumn Header="Ghi chú"
                                    Binding="{Binding Note, UpdateSourceTrigger=PropertyChanged}"
                                    Width="140"
                                    MinWidth="80"
                                    EditingElementStyle="{StaticResource LeftAlignedEditCell}"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,8">
            <TextBlock Text="Chọn mã có sẵn (gợi ý hiện danh mục/loại). Mặt hàng mới: nhập tên + đơn giá + danh mục/loại — trùng tên+giá sẽ hỏi chọn mã cũ hoặc tạo mã mới."
                       VerticalAlignment="Center"
                       Foreground="Gray"
                       Margin="0,0,16,0"
                       TextWrapping="Wrap"
                       MaxWidth="640"/>
            <Button Content="Thêm dòng" Command="{Binding AddLineCommand}" Margin="0,0,8,0"
                    Style="{StaticResource SuccessButtonStyle}"
                    ToolTip="Thêm dòng mới (Ctrl+N hoặc Ctrl+Insert)"/>
            <Button Content="Xóa dòng đã chọn" Command="{Binding RemoveSelectedLinesCommand}" Style="{StaticResource DangerButtonStyle}"/>
            <Button Content="Import Excel" Click="ImportExcel_Click" Margin="8,0,0,0" Style="{StaticResource ExportButtonStyle}"/>
        </StackPanel>

        <DockPanel Grid.Row="5">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock FontWeight="Bold" Text="{Binding TotalAmount, StringFormat=Tổng tiền: {0:N0}}"/>
                <TextBlock Text="{Binding UpperLevelAmount, StringFormat=Trên cấp: {0:N0}}"/>
                <TextBlock Text="{Binding SelfProcuredAmount, StringFormat=Tự mua sắm: {0:N0}}"/>
                <TextBlock Text="{Binding TotalAmountText, StringFormat=Bằng chữ: {0}}" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Lưu" Width="90" Margin="0,0,8,0" Click="Save_Click"
                        PreviewMouseLeftButtonDown="Save_OnPreviewMouseLeftButtonDown"
                        Style="{StaticResource PrimaryButtonStyle}"/>
                <Button Content="Hủy" Width="90" Click="Cancel_Click" Style="{StaticResource SecondaryButtonStyle}"/>
            </StackPanel>
        </DockPanel>

        <views:BusyOverlay x:Name="BusyOverlay"
                           Grid.RowSpan="6"
                           Panel.ZIndex="10"
                           Visibility="Collapsed"/>
    </Grid>
</Window>
