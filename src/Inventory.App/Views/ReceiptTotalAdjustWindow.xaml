<Window x:Class="Inventory.App.Views.ReceiptTotalAdjustWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Language="vi-VN"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Title="Điều chỉnh tổng tiền phiếu nhập"
        Height="520"
        Width="760"
        MinWidth="620"
        MinHeight="400">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10">
            <Run Text="Tổng tiền hiện tại:" />
            <Run x:Name="CurrentTotalRun" FontWeight="Bold"/>
            <LineBreak/>
            <Run Text="Nếu tổng chưa đúng (thường do đơn giá điều chỉnh theo VAT), nhập tổng tiền đúng bên dưới. App sẽ gợi ý chỉnh đơn giá (không đổi số lượng)."
                 Foreground="#FF475569"/>
        </TextBlock>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Tổng tiền đúng:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="TargetTotalBox" Width="180" VerticalContentAlignment="Center"
                     TextAlignment="Right" KeyDown="TargetTotalBox_OnKeyDown"/>
            <Button Content="Tính gợi ý" Margin="8,0,0,0" Padding="12,4"
                    Click="Calculate_OnClick" Style="{StaticResource PrimaryButtonStyle}"/>
        </StackPanel>

        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,0,0,8"
                   TextWrapping="Wrap" Foreground="#FF9A3412"/>

        <DataGrid x:Name="SuggestionsGrid"
                  Grid.Row="3"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  MouseDoubleClick="SuggestionsGrid_OnMouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Phương án" Binding="{Binding Summary}" Width="150"/>
                <DataGridTextColumn Header="Chi tiết thay đổi" Binding="{Binding Detail}" Width="*"/>
                <DataGridTextColumn Header="Tổng sau chỉnh" Binding="{Binding ResultingTotal, StringFormat=N0}" Width="120"/>
                <DataGridTextColumn Header="Sai lệch còn lại" Binding="{Binding ResidualDisplay}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <TextBlock Text="Chọn một phương án rồi bấm Áp dụng (hoặc nháy đúp)."
                       Foreground="Gray" VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Áp dụng" Width="100" Margin="0,0,8,0"
                        Click="Apply_OnClick" Style="{StaticResource PrimaryButtonStyle}"/>
                <Button Content="Đóng" Width="90" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
