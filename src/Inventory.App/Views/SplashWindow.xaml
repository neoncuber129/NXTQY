<Window x:Class="Inventory.App.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Khởi động ứng dụng"
        Width="460" Height="230"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True">

    <Border Background="White"
            BorderBrush="#FF2563EB"
            BorderThickness="1.5"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Color="#20000000" Direction="270" ShadowDepth="4"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header Panel -->
            <Border Grid.Row="0"
                    Background="#FF1E40AF"
                    CornerRadius="10,10,0,0"
                    Padding="24,18">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="QUẢN LÝ NHẬP XUẤT TỒN"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Hệ thống Quản lý Nhập - Xuất - Tồn"
                                   Foreground="#FFBFDBFE"
                                   FontSize="12"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border DockPanel.Dock="Right" Background="#FF2563EB" CornerRadius="6" Padding="8,4" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="v1.1" Foreground="White" FontSize="12" FontWeight="Bold"/>
                    </Border>
                </DockPanel>
            </Border>

            <!-- Progress Content -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="24,16,24,12">
                <DockPanel Margin="0,0,0,8">
                    <TextBlock x:Name="StatusTextBlock"
                               Text="Đang khởi động ứng dụng v1.1..."
                               FontSize="13"
                               Foreground="#FF374151"
                               FontWeight="SemiBold"
                               DockPanel.Dock="Left"/>
                    <TextBlock x:Name="PercentTextBlock"
                               Text="0%"
                               FontSize="13"
                               Foreground="#FF2563EB"
                               FontWeight="Bold"
                               HorizontalAlignment="Right"
                               DockPanel.Dock="Right"/>
                </DockPanel>

                <!-- Modern Progress Bar -->
                <ProgressBar x:Name="StartupProgressBar"
                             Height="8"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Foreground="#FF2563EB"
                             Background="#FFE5E7EB"
                             BorderThickness="0"/>
            </StackPanel>

            <!-- Footer Details -->
            <Border Grid.Row="2" Padding="24,0,24,14">
                <DockPanel>
                    <TextBlock x:Name="SubStatusTextBlock"
                               Text="Đang khởi tạo hệ thống..."
                               FontSize="11"
                               Foreground="#FF6B7280"
                               DockPanel.Dock="Left"/>
                    <TextBlock Text="v1.1"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#FF2563EB"
                               HorizontalAlignment="Right"
                               DockPanel.Dock="Right"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
