<Window x:Class="Inventory.App.Views.SubordinateUnitDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Language="vi-VN"
        Title="Thêm đơn vị trực thuộc"
        Width="500"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=UnitCodeBox}">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Mã đơn vị (*)" VerticalAlignment="Center" Margin="0,0,8,10"/>
        <TextBox x:Name="UnitCodeBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"
                 Text="{Binding UnitCode, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Tên đơn vị (*)" VerticalAlignment="Center" Margin="0,0,8,10"/>
        <TextBox x:Name="UnitNameBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"
                 Text="{Binding UnitName, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Người nhận" VerticalAlignment="Center" Margin="0,0,8,10"/>
        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,10"
                 Text="{Binding ReceivedBy, UpdateSourceTrigger=PropertyChanged}"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Ghi chú" VerticalAlignment="Top" Margin="0,4,8,0"/>
        <TextBox Grid.Row="3" Grid.Column="1" MinHeight="64" AcceptsReturn="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}"/>

        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Thêm đơn vị" Width="110" Margin="0,0,8,0"
                    IsDefault="True" Click="Add_OnClick"
                    Style="{StaticResource SuccessButtonStyle}"/>
            <Button Content="Hủy" Width="90" IsCancel="True"
                    Style="{StaticResource SecondaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
