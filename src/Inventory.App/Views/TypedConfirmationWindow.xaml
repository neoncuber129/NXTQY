<Window x:Class="Inventory.App.Views.TypedConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Language="vi-VN"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="460"
        Title="Xác nhận thay đổi tồn đầu"
        FocusManager.FocusedElement="{Binding ElementName=ConfirmationBox}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="12"
                Margin="0,0,0,14"
                Background="#FFFFF7ED"
                BorderBrush="#FFF97316"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel>
                <TextBlock Text="Cảnh báo thay đổi dữ liệu tính toán"
                           FontWeight="Bold"
                           Foreground="#FF9A3412"
                           Margin="0,0,0,6"/>
                <TextBlock TextWrapping="Wrap"
                           Text="Thay đổi tồn đầu có thể làm thay đổi tồn cuối, số liệu dashboard và khả năng xuất kho của cả năm."/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="1"
                   TextWrapping="Wrap"
                   Text="Để tiếp tục lưu, hãy nhập chữ yes vào ô bên dưới:"/>

        <TextBox Grid.Row="2"
                 x:Name="ConfirmationBox"
                 Height="34"
                 Margin="0,8,0,0"
                 MaxLength="20"
                 FontSize="16"
                 VerticalContentAlignment="Center"
                 TextChanged="ConfirmationBox_OnTextChanged"/>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="ConfirmButton"
                    Content="Xác nhận"
                    Width="100"
                    Margin="0,0,8,0"
                    IsDefault="True"
                    IsEnabled="False"
                    Click="Confirm_OnClick"
                    Style="{StaticResource PrimaryButtonStyle}"/>
            <Button Content="Hủy"
                    Width="90"
                    IsCancel="True"
                    Click="Cancel_OnClick"
                    Style="{StaticResource SecondaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
