<Window x:Class="Inventory.App.Views.WordPlaceholderHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Language="vi-VN"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Title="Danh sách placeholder Word"
        Height="640"
        Width="760">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0"
                   Text="Dùng đúng các placeholder bên dưới trong file Word template. Không tách chữ ${...}."
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"/>
        <TextBox Grid.Row="1"
                 x:Name="ContentBox"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="13"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Sao chép" Width="100" Margin="0,0,8,0" Click="Copy_OnClick" Style="{StaticResource PrimaryButtonStyle}"/>
            <Button Content="Đóng" Width="90" IsCancel="True" Click="Close_OnClick" Style="{StaticResource SecondaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
