<Window x:Class="Inventory.App.Views.YearPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Language="vi-VN"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Title="Chọn năm làm việc"
        SizeToContent="Height"
        Width="300"
        ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=YearBox}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0"
                   Text="Nhập năm để xem dashboard, phiếu và tồn đầu năm:"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"/>
        <TextBox Grid.Row="1"
                 x:Name="YearBox"
                 Height="32"
                 FontSize="18"
                 HorizontalContentAlignment="Center"
                 VerticalContentAlignment="Center"
                 MaxLength="4"
                 PreviewTextInput="YearBox_OnPreviewTextInput"
                 DataObject.Pasting="YearBox_OnPasting"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Chọn" Width="80" Height="28" Margin="0,0,8,0" IsDefault="True" Click="Ok_OnClick" Style="{StaticResource PrimaryButtonStyle}"/>
            <Button Content="Hủy" Width="80" Height="28" IsCancel="True" Click="Cancel_OnClick" Style="{StaticResource SecondaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
